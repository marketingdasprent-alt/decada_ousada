# ── WeGest (https://docs.wegest.pt) ─────────────────────────────
# Chave criada em WeGest → Integrações → Chaves de API (começa por wg_ra_).
# NUNCA usar prefixo NEXT_PUBLIC_ — só o servidor pode ver a chave.
# Para desenvolvimento: chave só com catalogo:read, disponibilidade:read, tvde:catalogo:read.
WEGEST_MODE=http            # http | mock
WEGEST_API_URL=https://api.wegest.pt/v1
WEGEST_API_KEY=
WEGEST_TIMEOUT=10000
# Reservas e candidaturas online com a API real (cria pedidos verdadeiros no WeGest).
# Deixar desligado até haver pagamentos reais, base de dados e CAPTCHA
# (docs/wegest/integracao.md). Desligado: os botões dão lugar a "Contactar a equipa".
WEGEST_PEDIDOS_ONLINE=off

# ── Contas de motorista (conta WeGest, DECISIONS.md 2026-10-14) ──
# Registo, login e recuperação de password no browser, direto no Supabase Auth do WeGest
# (guia do WeGest "Contas de motorista no site da Década"). Os três valores são públicos.
# Vazio = /entrar e a candidatura usam as contas próprias do site (demo e desenvolvimento).
# Cada domínio do site tem de estar autorizado no WeGest para os links de confirmação
# (/entrar?confirmado=1) e de recuperação (/nova-password).
NEXT_PUBLIC_WEGEST_AUTH_URL=https://hkqzzxgeedsmjnhyquke.supabase.co
NEXT_PUBLIC_WEGEST_AUTH_KEY=sb_publishable_jZ2mg1OT_rkWQj355mIPGA_MWcKh9WE
NEXT_PUBLIC_WEGEST_ORG_ID=11111111-1111-1111-1111-111111111111

# ── Base de dados local (users, vínculos, pagamentos) ───────────
DATABASE_URL=

# ── Pagamentos (fornecedor por decidir) ─────────────────────────
PAYMENT_PROVIDER=mock       # mock | stripe | ifthenpay | eupago | ...
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# ── Autenticação ────────────────────────────────────────────────
AUTH_SECRET=                # string aleatória longa (assinatura de sessões)

# ── Storage privado (documentos TVDE enquanto o WeGest não os recebe)
STORAGE_URL=
STORAGE_SECRET=

# ── Instagram (secção "Siga-nos no Instagram" na página inicial) ─
# Token de longa duração da Instagram API com login do Instagram (conta
# profissional @decada_ousada). Vazio = só a ligação ao perfil, sem publicações.
# Expira ao fim de 60 dias: renovar antes (ver docs/instagram.md).
INSTAGRAM_ACCESS_TOKEN=
# Alternativa ao token: URL do feed JSON de um serviço que gere o token (ex.: Behold).
# Só é usado sem INSTAGRAM_ACCESS_TOKEN.
INSTAGRAM_FEED_URL=

# ── Formulários de motoristas (/motoristas, docs/motoristas-formularios.md) ──
# Leads no WeGest, como os formulários públicos do WeGest. Sem os dois valores (com
# WEGEST_MODE=http), a página mostra os formulários alojados no WeGest.
WEGEST_LEADS_URL=https://hkqzzxgeedsmjnhyquke.supabase.co
WEGEST_LEADS_KEY=           # chave pública ("anon") dos formulários do WeGest (pedir ao WeGest)
# CAPTCHA Cloudflare Turnstile. Sem a chave secreta, só há o campo-armadilha contra robôs.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Domínios ────────────────────────────────────────────────────
# Deixar vazio até os domínios estarem ligados (demo em *.vercel.app):
# sem APP_URL o robots.txt bloqueia a indexação e a troca de região usa ?regiao=.
APP_URL=https://www.decadaousada.pt
AZORES_APP_URL=https://acores.decadaousada.pt

# ── Meta Pixel (Facebook e Instagram, DECISIONS.md 2026-10-14) ───
# Id do pixel (não é segredo). Vazio = sem pixel e sem aviso de cookies.
# O pixel carrega logo e só para se o visitante escolher "Só necessários".
# Em produção vem do .env.production (versionado); uma variável na Vercel sobrepõe-se.
NEXT_PUBLIC_META_PIXEL_ID=

# CAPTCHA do Supabase Auth: chave pública do widget Turnstile.
# A chave secreta correspondente fica no painel Supabase Auth do WeGest.
# Sem esta chave pública, o registo de contas WeGest fica indisponível.
# É lida no build: depois de a mudar na Vercel, é preciso um deploy novo.
NEXT_PUBLIC_WEGEST_AUTH_CAPTCHA_SITE_KEY=
