# ── WeGest (https://docs.wegest.pt) ─────────────────────────────
# Chave criada em WeGest → Integrações → Chaves de API (começa por wg_ra_).
# NUNCA usar prefixo NEXT_PUBLIC_ — só o servidor pode ver a chave.
# Para desenvolvimento: chave só com catalogo:read, disponibilidade:read, tvde:catalogo:read.
WEGEST_MODE=http            # http | mock
WEGEST_API_URL=https://api.wegest.pt/v1
WEGEST_API_KEY=
WEGEST_TIMEOUT=10000
# Reservas e candidaturas online com a API real (cria pedidos verdadeiros no WeGest).
# Deixar desligado até haver pagamentos reais, base de dados e CAPTCHA
# (docs/wegest/integracao.md). Desligado: os botões dão lugar a "Contactar a equipa".
WEGEST_PEDIDOS_ONLINE=off

# ── Base de dados local (users, vínculos, pagamentos) ───────────
DATABASE_URL=

# ── Pagamentos (fornecedor por decidir) ─────────────────────────
PAYMENT_PROVIDER=mock       # mock | stripe | ifthenpay | eupago | ...
PAYMENT_PUBLIC_KEY=
PAYMENT_SECRET_KEY=

# ── Autenticação ────────────────────────────────────────────────
AUTH_SECRET=                # string aleatória longa (assinatura de sessões)

# ── Storage privado (documentos TVDE enquanto o WeGest não os recebe)
STORAGE_URL=
STORAGE_SECRET=

# ── Instagram (secção "Siga-nos no Instagram" na página inicial) ─
# Token de longa duração da Instagram API com login do Instagram (conta
# profissional @decada_ousada). Vazio = só a ligação ao perfil, sem publicações.
# Expira ao fim de 60 dias: renovar antes (ver docs/instagram.md).
INSTAGRAM_ACCESS_TOKEN=
# Alternativa ao token: URL do feed JSON de um serviço que gere o token (ex.: Behold).
# Só é usado sem INSTAGRAM_ACCESS_TOKEN.
INSTAGRAM_FEED_URL=

# ── Domínios ────────────────────────────────────────────────────
# Deixar vazio até os domínios estarem ligados (demo em *.vercel.app):
# sem APP_URL o robots.txt bloqueia a indexação e a troca de região usa ?regiao=.
APP_URL=https://www.decadaousada.pt
AZORES_APP_URL=https://acores.decadaousada.pt
